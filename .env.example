QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=first_aid_chunks
OLLAMA_BASE_URL=http://localhost:11434
GENERATION_MODEL=qwen3:4b
AGENT_PROVIDER=auto
AGENT_MODEL=qwen/qwen3.6-27b
AGENT_FALLBACK_MODEL=qwen3:4b
AGENT_TIMEOUT_SECONDS=60
SUPERVISOR_PROVIDER=auto
GROQ_API_KEY=
GENERATION_PROVIDER=ollama
GENERATION_MODEL=qwen3:4b
GENERATION_TIMEOUT_SECONDS=60
GENERATION_FALLBACK_MODEL=qwen3:4b
# Arabic retrieval searches both the original query and an English translation.
# auto tries OpenRouter, then Groq, then the local Ollama fallback.
ARABIC_QUERY_TRANSLATION_ENABLED=true
ARABIC_QUERY_TRANSLATION_PROVIDER=auto
ARABIC_QUERY_TRANSLATION_OPENROUTER_MODEL=qwen/qwen3.5-flash-02-23
ARABIC_QUERY_TRANSLATION_MODEL=qwen/qwen3.6-27b
ARABIC_QUERY_TRANSLATION_FALLBACK_MODEL=qwen3:4b
ARABIC_QUERY_TRANSLATION_TIMEOUT_SECONDS=20
GROQ_SUPERVISOR_MODEL=openai/gpt-oss-120b
SUPERVISOR_TIMEOUT_SECONDS=20
# Container default is supplied by docker-compose; local runs infer this automatically.
# PROJECT_ROOT=/app
# PDF-ingestion VLM remains local through Ollama.
INGEST_VISION_MODEL=qwen2.5vl:7b
INGEST_VISION=true
# User-uploaded images use OpenRouter when a key is configured, with local
# Ollama fallback. Never commit the real key.
UPLOAD_VISION_PROVIDER=auto
UPLOAD_VISION_MODEL=qwen/qwen3-vl-32b-instruct
UPLOAD_VISION_FALLBACK_MODEL=qwen2.5vl:7b
UPLOAD_VISION_TIMEOUT_SECONDS=30
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MAX_PDF_UPLOAD_BYTES=104857600
ALLOW_MODEL_DOWNLOAD=false
WEB_SEARCH_MAX_RESULTS=5
MONGODB_URL=mongodb://localhost:27018
MONGODB_DATABASE=first_aid
# Persistent structured Agent A request/route/error log
AGENT_LOG_MAX_BYTES=10485760
AGENT_LOG_BACKUP_COUNT=5
AGENT_SYSTEM_B_URL=http://localhost:8001
AGENT_SYSTEM_B_TIMEOUT_SECONDS=20
AGENT_SYSTEM_B_RETRIES=1
AGENT_B_MODEL=qwen/qwen3.6-27b
AGENT_B_TIMEOUT_SECONDS=20
AGENT_B_MONGODB_DATABASE=mental_health_appointments
APPOINTMENT_TIMEZONE=Asia/Beirut
REMINDER_POLL_SECONDS=10
REMINDER_HTTP_TIMEOUT_SECONDS=10
# Generate a long random value locally. Never commit the real token.
INTERNAL_SERVICE_TOKEN=
MCP_SERVER_URL=http://localhost:8002/mcp
MCP_TIMEOUT_SECONDS=20
